    if RootPart then
        Camera.CameraType = Enum.CameraType.Scriptable

        local position =
            RootPart.Position
            - Camera.CFrame.LookVector * State.ThirdPersonDistance
            + Vector3.new(0, 3, 0)

        Camera.CFrame = CFrame.lookAt(
            position,
            RootPart.Position + Vector3.new(0, 2, 0)
