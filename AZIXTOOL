----------------------------------------------------------------
-- LOCK CAMERA
----------------------------------------------------------------

local function updateLock()
    if not State.Lock then
        return
    end

    local target = State.LockTarget

    if not target or not target.Parent then
        State.Lock = false
        State.LockTarget = nil
        return
    end

    local targetRoot = getRoot(target)
    local targetHumanoid = getHumanoid(target)

    if not targetRoot
        or not targetHumanoid
        or targetHumanoid.Health <= 0 then

        State.Lock = false
        State.LockTarget = nil
        return
    end

    if RootPart then
        local distance =
            (targetRoot.Position - RootPart.Position).Magnitude

        if distance > State.LockDistance then
            State.Lock = false
            State.LockTarget = nil
            LockStatus.Text = "TARGET: NONE"
            return
        end

        Camera.CFrame = CFrame.lookAt(
            Camera.CFrame.Position,
            targetRoot.Position
        )

        LockStatus.Text =
            "TARGET: " ..
            target.DisplayName ..
            "  //  " ..
            math.floor(distance) ..
            " STUDS"
    end
end

