local function executeBind(name)
    if name == "Lock" then
        if State.Lock then
            State.Lock = false
            State.LockTarget = nil
        else
            local nearest
            local distance = State.LockDistance

            if RootPart then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local root = getRoot(player)
                        local humanoid = getHumanoid(player)

                        if root and humanoid and humanoid.Health > 0 then
                            local d =
                                (root.Position - RootPart.Position).Magnitude

                            if d <= distance then
                                nearest = player
                                distance = d
                            end
                        end
                    end
                end
            end

            if nearest then
                State.Lock = true
                State.LockTarget = nearest
            end
        end

    elseif name == "Fly" then
        State.Fly = not State.Fly
        if State.Fly then
            State.VFly = false
        end

    elseif name == "VFly" then
        State.VFly = not State.VFly
        if State.VFly then
            State.Fly = false
        end

    elseif name == "Noclip" then
        State.Noclip = not State.Noclip

    elseif name == "InfiniteJump" then
        State.InfiniteJump = not State.InfiniteJump

    elseif name == "AntiFall" then
        State.AntiFall = not State.AntiFall

    elseif name == "GodMode" then
        State.GodMode = not State.GodMode

    elseif name == "ResetVelocity" then
        if RootPart then
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end

    elseif name == "TPTool" then
        createTPTool()

    elseif name == "Goto" then
        local root = getRoot(State.SelectedPlayer)

        if root and RootPart then
            RootPart.CFrame =
                root.CFrame * CFrame.new(0, 0, -4)
        end

    elseif name == "Bring" then
        local root = getRoot(State.SelectedPlayer)

        if root and RootPart then
            root.CFrame =
                RootPart.CFrame * CFrame.new(0, 0, -4)
        end

    elseif name == "SavePosition" then
        if RootPart then
            State.SavedPosition = RootPart.CFrame
        end

    elseif name == "ReturnPosition" then
        if RootPart and State.SavedPosition then
            RootPart.CFrame = State.SavedPosition
        end

    elseif name == "Fling" then
        if RootPart then
            local targetRoot = getRoot(State.SelectedPlayer)

            if targetRoot then
                local direction =
                    targetRoot.Position - RootPart.Position

                if direction.Magnitude > 0.1 then
                    RootPart.AssemblyLinearVelocity =
                        direction.Unit * State.FlingPower
                end
            end
        end

    elseif name == "AntiFling" then
        State.AntiFling = not State.AntiFling

    elseif name == "PlayerESP" then
        State.ESP.Player = not State.ESP.Player

    elseif name == "BoxESP" then
        State.ESP.Box = not State.ESP.Box

    elseif name == "NameESP" then
        State.ESP.Name = not State.ESP.Name

    elseif name == "DistanceESP" then
        State.ESP.Distance = not State.ESP.Distance

    elseif name == "HealthESP" then
        State.ESP.Health = not State.ESP.Health

    elseif name == "SkeletonESP" then
        State.ESP.Skeleton = not State.ESP.Skeleton

    elseif name == "TracerESP" then
        State.ESP.Tracer = not State.ESP.Tracer

    elseif name == "Spin" then
        State.Spin = not State.Spin

    elseif name == "BunnyHop" then
        State.BunnyHop = not State.BunnyHop

    elseif name == "AutoSprint" then
        State.AutoSprint = not State.AutoSprint

    elseif name == "Freecam" then
        State.Freecam = not State.Freecam

        if not State.Freecam then
            Camera.CameraType = Enum.CameraType.Custom

            if Humanoid then
                Camera.CameraSubject = Humanoid
            end

            FreecamPosition = nil
        end

    elseif name == "ThirdPerson" then
        State.ThirdPerson = not State.ThirdPerson

    elseif name == "Fullbright" then
        State.Fullbright = not State.Fullbright

    elseif name == "Crosshair" then
        State.Crosshair = not State.Crosshair

    elseif name == "RainbowCharacter" then
        State.RainbowCharacter = not State.RainbowCharacter

    elseif name == "OpenPanel" then
        if Closed then
            showPanel()
        else
            hidePanel()
        end
    end
end

