local TracerGui = Instance.new("ScreenGui")
TracerGui.Name = "Tracers"
TracerGui.IgnoreGuiInset = true
TracerGui.ResetOnSpawn = false
TracerGui.DisplayOrder = 70
TracerGui.Parent = PlayerGui

local Tracers = {}

local function getTracer(player)
    if Tracers[player] then
        return Tracers[player]
    end

    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = COLORS.Green
    line.BorderSizePixel = 0
    line.Visible = false
    line.Parent = TracerGui

    Tracers[player] = line

    return line
end

local function updateTracers()
    if not RootPart then
        return
    end

    local viewport = Camera.ViewportSize

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local line = getTracer(player)
            local root = getRoot(player)

            if not State.ESP.Tracer or not root then
                line.Visible = false
                continue
            end

            local distance =
                (root.Position - RootPart.Position).Magnitude

            if distance > State.ESP.MaxDistance then
                line.Visible = false
                continue
            end

            local screen, visible =
                Camera:WorldToViewportPoint(root.Position)

            if not visible or screen.Z <= 0 then
                line.Visible = false
                continue
            end

            local start =
                Vector2.new(
                    viewport.X / 2,
                    viewport.Y
                )

            local finish =
                Vector2.new(
                    screen.X,
                    screen.Y
                )

            local delta = finish - start

            line.Position = UDim2.fromOffset(
                (start.X + finish.X) / 2,
                (start.Y + finish.Y) / 2
            )

            line.Size = UDim2.fromOffset(
                delta.Magnitude,
                1
            )

            line.Rotation =
                math.deg(
                    math.atan2(delta.Y, delta.X)
                )

            line.Visible = true
        end
    end
end

