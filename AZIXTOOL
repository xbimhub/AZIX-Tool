    end

    destroyFlyObjects()

    State.Lock = false
    State.LockTarget = nil

    if State.ResetOnDeath then
        State.Fly = false
        State.VFly = false
        State.Noclip = false
    end
end))

----------------------------------------------------------------
-- LOGIN
----------------------------------------------------------------

local function authenticate()
    if LoginInput.Text == PASSWORD then
        State.Authenticated = true

        LoginStatus.Text = "STATUS: ACCESS GRANTED"
        LoginStatus.TextColor3 = COLORS.Green

        tween(LoginFrame, {
            BackgroundTransparency = 1
        }, 0.2):Play()

        task.delay(0.22, function()
            LoginFrame.Visible = false
            Main.Visible = true

            MainScale.Scale = 0.92

            tween(MainScale, {
                Scale = 1
            }, 0.25):Play()
        end)
    else
        LoginStatus.Text = "STATUS: ACCESS DENIED"
        LoginStatus.TextColor3 = COLORS.Red

        LoginInput.Text = ""

        tween(LoginFrame, {
            Position = UDim2.fromScale(0.505, 0.5)
        }, 0.05):Play()

        task.delay(0.05, function()
            tween(LoginFrame, {
                Position = UDim2.fromScale(0.495, 0.5)
            }, 0.05):Play()
        end)

        task.delay(0.1, function()
            tween(LoginFrame, {
                Position = UDim2.fromScale(0.5, 0.5)
            }, 0.05):Play()
        end)
    end
end

connect(LoginButton.MouseButton1Click:Connect(authenticate))

connect(LoginInput.FocusLost:Connect(function(enter)
    if enter then
        authenticate()
    end
end))

