local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESP"
ESPFolder.Parent = ScreenGui

local ESPData = {}

local function destroyESP(player)
    local data = ESPData[player]

    if not data then
        return
    end

    for _, object in pairs(data) do
        if typeof(object) == "Instance" then
            pcall(function()
                object:Destroy()
            end)
        end
    end

    ESPData[player] = nil
end

local function createESP(player)
    if ESPData[player] then
        return ESPData[player]
    end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = COLORS.Green
    highlight.OutlineColor = COLORS.Green
    highlight.FillTransparency = 0.85
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = ESPFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.fromOffset(180, 60)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = ESPFolder

    local info = label(
        billboard,
        "",
        UDim2.fromScale(1, 1)
    )

    info.TextColor3 = COLORS.Green
    info.TextStrokeTransparency = 0.3
    info.TextXAlignment = Enum.TextXAlignment.Center
    info.TextYAlignment = Enum.TextYAlignment.Center
    info.TextSize = 9

    local box = Instance.new("BoxHandleAdornment")
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Transparency = 0.55
    box.Color3 = COLORS.Green
    box.Visible = false
    box.Parent = ESPFolder

    local data = {
        Highlight = highlight,
        Billboard = billboard,
        Info = info,
        Box = box,
    }

    ESPData[player] = data

    return data
end

local function updateESP()
    if not RootPart then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local root = getRoot(player)
            local humanoid = getHumanoid(player)
            local character = player.Character

            local data = createESP(player)

            if root and humanoid and character and humanoid.Health > 0 then
                local distance =
                    (root.Position - RootPart.Position).Magnitude

                local visible =
                    distance <= State.ESP.MaxDistance

                data.Highlight.Adornee = character
                data.Highlight.Enabled =
                    State.ESP.Player and visible

                data.Billboard.Adornee = root
                data.Billboard.Enabled =
                    visible and (
                        State.ESP.Name
                        or State.ESP.Distance
                        or State.ESP.Health
                    )

                local lines = {}

                if State.ESP.Name then
                    table.insert(lines, player.DisplayName)
                end

                if State.ESP.Distance then
                    table.insert(
                        lines,
                        math.floor(distance) .. " studs"
                    )
                end

                if State.ESP.Health then
                    table.insert(
                        lines,
                        math.floor(humanoid.Health)
                        .. " / "
                        .. math.floor(humanoid.MaxHealth)
                    )
                end

                data.Info.Text =
                    table.concat(lines, "\n")

                local _, size =
                    character:GetBoundingBox()

                data.Box.Adornee = root
                data.Box.Size = size
                data.Box.Visible =
                    State.ESP.Box and visible
            else
                data.Highlight.Enabled = false
                data.Billboard.Enabled = false
                data.Box.Visible = false
            end
        end
    end
end

