local function createPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.new(1, -12, 1, -12)
    page.Position = UDim2.fromOffset(6, 6)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = COLORS.Green
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new()
    page.Visible = false
    page.Parent = Content

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 7)
    padding.PaddingRight = UDim.new(0, 7)
    padding.PaddingTop = UDim.new(0, 7)
    padding.PaddingBottom = UDim.new(0, 12)
    padding.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 7)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    Pages[name] = page

    return page
end

local CurrentCategory

local function selectCategory(name)
    CurrentCategory = name

    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for categoryName, data in pairs(CategoryButtons) do
        local selected = categoryName == name

        tween(data.Button, {
            BackgroundColor3 = selected
                and Color3.fromRGB(8, 42, 36)
                or COLORS.Panel
        }, 0.18):Play()

        tween(data.Marker, {
            Size = selected
                and UDim2.fromOffset(3, 24)
                or UDim2.fromOffset(0, 24)
        }, 0.18):Play()

        data.NameLabel.TextColor3 =
            selected and COLORS.Green or COLORS.Text

        data.NumberLabel.TextColor3 =
            selected and COLORS.Green2 or COLORS.Muted

        if selected then
            data.Button.Position = UDim2.fromOffset(3, data.Button.Position.Y.Offset)
        else
            data.Button.Position = UDim2.fromOffset(0, data.Button.Position.Y.Offset)
        end
    end

    local page = Pages[name]

    if page then
        page.Position = UDim2.fromOffset(18, 6)

        tween(page, {
            Position = UDim2.fromOffset(6, 6)
        }, 0.22):Play()
    end
end

