local ESPTimer = 0

connect(RunService.RenderStepped:Connect(function(delta)
    if not State.Authenticated then
        return
    end

    refreshCharacter()

    if Humanoid then
        Humanoid.UseJumpPower = true

        if not State.AutoSprint then
            Humanoid.WalkSpeed = State.WalkSpeed
        end

        Humanoid.JumpPower = State.JumpPower
        Humanoid.HipHeight = State.HipHeight
    end

    updateFly()
    updateNoclip()
    updateGodMode()
    updateAntiFling()
    updateSafety()
    updateCharacterOptions(delta)
    updateWorld()
    updateLock()
    updateThirdPerson()
    updateFreecam()
    updateCrosshair()

    ESPTimer += delta

    if ESPTimer >= 0.08 then
        ESPTimer = 0
        updateESP()
        updateTracers()
    end

    updateDebug(delta)

    if State.CameraShake then
        local amount =
            State.CameraShakePower * 0.025

        Camera.CFrame =
            Camera.CFrame
            * CFrame.Angles(
                (math.random() - 0.5) * amount,
                (math.random() - 0.5) * amount,
                (math.random() - 0.5) * amount
            )
    end
end))

