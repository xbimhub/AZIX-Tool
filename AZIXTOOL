local RainbowHue = 0

local function updateCharacterOptions(delta)
    if not Character or not Humanoid then
        return
    end

    if State.PlatformStand then
        Humanoid.PlatformStand = true
    else
        Humanoid.PlatformStand = false
    end

    if State.Sit then
        Humanoid.Sit = true
    end

    if State.Freeze and RootPart then
        RootPart.Anchored = true
    elseif RootPart then
        RootPart.Anchored = false
    end

    if State.AutoSprint then
        Humanoid.WalkSpeed = math.max(
            State.WalkSpeed,
            24
        )
    else
        Humanoid.WalkSpeed = State.WalkSpeed
    end

    if State.BunnyHop then
        if Humanoid.FloorMaterial ~= Enum.Material.Air then
            Humanoid.Jump = true
        end
    end

    if State.FastFall and RootPart then
        local velocity = RootPart.AssemblyLinearVelocity

        if velocity.Y < 0 then
            RootPart.AssemblyLinearVelocity =
                Vector3.new(
                    velocity.X,
                    velocity.Y * 1.35,
                    velocity.Z
                )
        end
    end

    if State.Spin and RootPart then
        RootPart.AssemblyAngularVelocity =
            Vector3.new(
                0,
                State.SpinSpeed,
                0
            )
    end

    if State.Headless then
        local head = Character:FindFirstChild("Head")

        if head then
            head.Transparency = 1
            head.CanCollide = false
        end
    end

    if State.BigHead then
        local head = Character:FindFirstChild("Head")

        if head then
            head.Size = Vector3.new(2.5, 2.5, 2.5)
        end
    elseif State.SmallHead then
        local head = Character:FindFirstChild("Head")

        if head then
            head.Size = Vector3.new(0.5, 0.5, 0.5)
        end
    end

    if State.RemoveAccessories then
        for _, object in ipairs(Character:GetChildren()) do
            if object:IsA("Accessory") then
                object.Handle.LocalTransparencyModifier = 1
            end
        end
    end

    if State.HideName then
        local head = Character:FindFirstChild("Head")

        if head then
            local billboard = head:FindFirstChildWhichIsA(
                "BillboardGui"
            )

            if billboard then
                billboard.Enabled = false
            end
        end
    end

    if State.RainbowCharacter then
        RainbowHue += delta * 0.2

        if RainbowHue > 1 then
            RainbowHue -= 1
        end

        local color =
            Color3.fromHSV(RainbowHue, 0.85, 1)

        for _, object in ipairs(Character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.Color = color
            end
        end
    end

    if State.Wireframe then
        for _, object in ipairs(Character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.LocalTransparencyModifier = 0
            end
        end
    end
end

