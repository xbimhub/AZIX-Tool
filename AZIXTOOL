local function createToggle(parent, titleText, getter, setter)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = COLORS.Panel
    row.BorderSizePixel = 0
    row.Parent = parent

    corner(row, 7)
    stroke(row, COLORS.Border, 0.45)

    local title = label(
        row,
        titleText,
        UDim2.new(1, -75, 1, 0),
        UDim2.fromOffset(11, 0)
    )

    title.TextSize = 9

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.fromOffset(42, 20)
    switch.Position = UDim2.new(1, -52, 0.5, -10)
    switch.BackgroundColor3 = COLORS.Off
    switch.Text = ""
    switch.BorderSizePixel = 0
    switch.AutoButtonColor = false
    switch.Parent = row

    corner(switch, 10)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = UDim2.fromOffset(2, 2)
    knob.BackgroundColor3 = COLORS.OffKnob
    knob.BorderSizePixel = 0
    knob.Parent = switch

    corner(knob, 8)

    local function update()
        local enabled = getter()

        tween(switch, {
            BackgroundColor3 = enabled
                and COLORS.Green2
                or COLORS.Off
        }, 0.18):Play()

        tween(knob, {
            Position = enabled
                and UDim2.new(1, -18, 0, 2)
                or UDim2.fromOffset(2, 2),

            BackgroundColor3 = enabled
                and COLORS.Green
                or COLORS.OffKnob
        }, 0.18):Play()
    end

    connect(switch.MouseButton1Click:Connect(function()
        setter(not getter())
        update()
    end))

    update()

    return row, update
end

local function createNumber(parent, titleText, value, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = COLORS.Panel
    row.BorderSizePixel = 0
    row.Parent = parent

    corner(row, 7)
    stroke(row, COLORS.Border, 0.45)

    label(
        row,
        titleText,
        UDim2.new(1, -130, 1, 0),
        UDim2.fromOffset(11, 0)
    )

    local box = textbox(
        row,
        value,
        UDim2.fromOffset(110, 26)
    )

    box.Position = UDim2.new(1, -118, 0.5, -13)

    connect(box.FocusLost:Connect(function(enter)
        if enter then
            local result = clampNumber(box.Text, value)
            box.Text = tostring(result)
            callback(result)
        end
    end))

    return box
end

local function createAction(parent, titleText, callback)
    local b = button(
        parent,
        titleText,
        UDim2.new(1, 0, 0, 36)
    )

    connect(b.MouseButton1Click:Connect(callback))

    return b
end

