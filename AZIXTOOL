local BindBoxes = {}

local function normalizeKey(value)
    value = tostring(value or ""):upper()
    value = value:gsub("%s+", "")

    if value == "" or value == "NONE" then
        return "NONE"
    end

    local aliases = {
        ENTER = "RETURN",
        CTRL = "LEFTCONTROL",
        CONTROL = "LEFTCONTROL",
        SHIFT = "LEFTSHIFT",
        ALT = "LEFTALT",
        ESC = "ESCAPE",
    }

    return aliases[value] or value
end

local KeyCodes = {}

for _, key in ipairs(Enum.KeyCode:GetEnumItems()) do
    KeyCodes[key.Name:upper()] = key
end

local function setBind(name, value)
    local key = normalizeKey(value)

    if key ~= "NONE" and not KeyCodes[key] then
        BindWarning.Text = "INVALID KEY: " .. key
        return false
    end

    if key ~= "NONE" then
        for otherName, otherValue in pairs(State.Binds) do
            if otherName ~= name and otherValue == key then
                BindWarning.Text =
                    "KEY ALREADY USED BY: " ..
                    (BindNames[otherName] or otherName)

                return false
            end
        end
    end

    State.Binds[name] = key

    if BindBoxes[name] then
        BindBoxes[name].Text = key
    end

    BindWarning.Text = ""

    return true
end

for name, displayName in pairs(BindNames) do
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 34)
