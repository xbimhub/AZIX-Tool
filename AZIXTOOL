----------------------------------------------------------------

local function updateAntiFling()
    if not State.AntiFling or not RootPart then
        return
    end

    local velocity = RootPart.AssemblyLinearVelocity
    local angular = RootPart.AssemblyAngularVelocity

    if velocity.Magnitude > 150 then
        RootPart.AssemblyLinearVelocity =
            velocity.Unit * 150
    end

    if angular.Magnitude > 100 then
        RootPart.AssemblyAngularVelocity =
            angular.Unit * 100
    end
end

----------------------------------------------------------------
-- ANTI FALL / ANTI VOID
----------------------------------------------------------------

local LastSafeCFrame

local function updateSafety()
    if not RootPart then
        return
    end

    if RootPart.Position.Y > -100 then
        LastSafeCFrame = RootPart.CFrame
    end

    if State.AntiFall then
        local velocity = RootPart.AssemblyLinearVelocity

        if velocity.Y < -70 then
            RootPart.AssemblyLinearVelocity =
                Vector3.new(
                    velocity.X,
                    -8,
                    velocity.Z
                )
        end
    end

    if State.AntiVoid and RootPart.Position.Y < -80 then
        if LastSafeCFrame then
            RootPart.CFrame = LastSafeCFrame
            RootPart.AssemblyLinearVelocity = Vector3.zero
        end
    end

    if State.AutoRecover and RootPart.Position.Y < -120 then
        if LastSafeCFrame then
            RootPart.CFrame = LastSafeCFrame
        end
    end
end

