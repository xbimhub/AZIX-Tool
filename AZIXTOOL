----------------------------------------------------------------
-- UI HELPERS
----------------------------------------------------------------

local function corner(parent, radius)
    local object = Instance.new("UICorner")
    object.CornerRadius = UDim.new(0, radius or 6)
    object.Parent = parent
    return object
end

local function stroke(parent, color, transparency)
    local object = Instance.new("UIStroke")
    object.Color = color or COLORS.Border
    object.Transparency = transparency or 0
    object.Thickness = 1
    object.Parent = parent
    return object
end

local function tween(object, properties, duration)
    return TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.18,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        properties
    )
end

local function label(parent, text, size, position)
    local object = Instance.new("TextLabel")
    object.BackgroundTransparency = 1
    object.Size = size
    object.Position = position or UDim2.new()
    object.Text = text
    object.TextColor3 = COLORS.Text
    object.Font = Enum.Font.Code
    object.TextSize = 11
    object.TextXAlignment = Enum.TextXAlignment.Left
    object.Parent = parent
    return object
end

local function button(parent, text, size)
    local object = Instance.new("TextButton")
    object.Size = size
    object.BackgroundColor3 = COLORS.Panel
    object.BorderSizePixel = 0
    object.Text = text
    object.TextColor3 = COLORS.Text
    object.Font = Enum.Font.Code
    object.TextSize = 11
    object.AutoButtonColor = false
    object.Parent = parent

    corner(object, 6)
    stroke(object, COLORS.Border, 0.3)

    connect(object.MouseEnter:Connect(function()
        tween(object, {
            BackgroundColor3 = Color3.fromRGB(15, 32, 31)
        }, 0.12):Play()
    end))

    connect(object.MouseLeave:Connect(function()
        tween(object, {
            BackgroundColor3 = COLORS.Panel
        }, 0.12):Play()
    end))

    connect(object.MouseButton1Down:Connect(function()
        tween(object, {
            BackgroundColor3 = COLORS.Green2
        }, 0.08):Play()
    end))

    connect(object.MouseButton1Up:Connect(function()
        tween(object, {
            BackgroundColor3 = COLORS.Panel2
        }, 0.08):Play()
    end))

    return object
end

local function textbox(parent, value, size)
    local object = Instance.new("TextBox")
    object.Size = size
    object.BackgroundColor3 = COLORS.Panel
    object.BorderSizePixel = 0
    object.Text = tostring(value)
    object.TextColor3 = COLORS.Text
    object.PlaceholderColor3 = COLORS.Muted
    object.Font = Enum.Font.Code
    object.TextSize = 10
    object.ClearTextOnFocus = false
    object.Parent = parent

    corner(object, 6)
    stroke(object, COLORS.Border, 0.25)

    return object
end

